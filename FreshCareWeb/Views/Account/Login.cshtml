@{
    ViewData["Title"] = "Đăng Nhập FreshCare";
    // Ẩn thanh menu ngang ở trang đăng nhập
    Layout = null; 
}
<!DOCTYPE html>
<html>
<head>
    <title>Đăng nhập - FreshCare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #e9ecef; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .login-card { width: 400px; padding: 30px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background: #fff; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <h2 class="text-success fw-bold">🌱 FRESHCARE</h2>
            <p class="text-muted">Hệ thống quản lý kho thông minh</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Tài khoản</label>
                <input type="text" name="taikhoan" class="form-control" placeholder="Nhập: admin" required>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Mật khẩu</label>
                <input type="password" name="matkhau" class="form-control" placeholder="Nhập: 123" required>
            </div>
            <button type="submit" class="btn btn-success w-100 fw-bold fs-5">ĐĂNG NHẬP</button>
            <div class="text-center mt-3"><p>Chưa có tài khoản? <a href="/Account/Register" class="text-success fw-bold">Đăng ký ngay</a></p></div>
        </form>
    </div>
</body>
</html>
@{
    ViewData["Title"] = "Báo Cáo Thống Kê";
}

<div class="container mt-5">
    <h2 class="text-center text-primary fw-bold mb-5"><i class="fas fa-chart-pie"></i> BÁO CÁO KINH DOANH FRESHCARE</h2>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-success shadow-sm mb-4">
                <div class="card-body text-center p-5">
                    <h5 class="text-muted fw-bold mb-3">TỔNG DOANH THU BÁN HÀNG</h5>
                    <h1 class="display-4 text-success fw-bold">@ViewBag.TongDoanhThu.ToString("N0") VNĐ</h1>
                    <p class="text-muted mt-2"><i class="fas fa-arrow-up text-success"></i> Được tính từ các phiếu xuất bán thành công</p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-body text-center p-5">
                    <h5 class="text-muted fw-bold mb-3">TỔNG SẢN PHẨM THẤT THOÁT / HỦY</h5>
                    <h1 class="display-4 text-danger fw-bold">@ViewBag.TongHangHuy Kg/Bó</h1>
                    <p class="text-muted mt-2"><i class="fas fa-exclamation-triangle text-danger"></i> Các lô hàng cận/quá date đã được xuất hủy</p>
                </div>
            </div>
        </div>
    </div>
</div>
@using FreshCareWeb.Controllers
@{
    ViewData["Title"] = "Quản lý Tồn kho FreshCare";
    var hangQuaHan = ViewBag.HangQuaHan as List<LoHangViewModel>;
    var hangCanDate = ViewBag.HangCanDate as List<LoHangViewModel>;
    var hangAnToan = ViewBag.HangAnToan as List<LoHangViewModel>;
}

<div class="container mt-4">
    <h2 class="text-center text-primary fw-bold mb-4">HỆ THỐNG QUẢN LÝ KHO FRESHCARE</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
            <strong>Thông báo:</strong> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card border-danger mb-4">
                <div class="card-header bg-danger text-white fw-bold">
                    🚨 HÀNG QUÁ HẠN SỬ DỤNG (YÊU CẦU HỦY)
                </div>
                <div class="card-body">
                    <table class="table table-bordered text-center align-middle">
                        <thead>
                            <tr>
                                <th>Mã Lô</th>
                                <th>Sản Phẩm</th>
                                <th>Hạn SD</th>
                                <th>Tồn Kho</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in hangQuaHan)
                            {
                                <tr class="table-danger">
                                    <td class="fw-bold">@item.MaLo</td>
                                    <td>@item.TenSP<br><small class="text-muted">(@item.DonViTinh)</small></td>
                                    <td>@item.HanSuDung.ToString("dd/MM/yyyy")<br><span class="badge bg-dark">Đã hết hạn</span></td>
                                    <td class="text-danger fw-bold">@item.SoLuongTon @item.DonViTinh</td>
                                    <td>
                                        <form asp-action="HuyHang" method="post">
                                            <input type="hidden" name="maLo" value="@item.MaLo" />
                                            <button type="submit" class="btn btn-sm btn-dark" onclick="return confirm('Xác nhận xuất hủy lô hàng này để ghi nhận thất thoát?')">Xuất Hủy</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card border-warning mb-4">
                <div class="card-header bg-warning text-dark fw-bold">
                    ⚠️ HÀNG CẬN DATE (ĐANG ÁP DỤNG SALE)
                </div>
                <div class="card-body">
                    <table class="table table-bordered text-center align-middle">
                        <thead>
                            <tr>
                                <th>Sản Phẩm</th>
                                <th>Hạn SD</th>
                                <th>Tồn Kho</th>
                                <th>Giá Bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in hangCanDate)
                            {
                                <tr class="table-warning">
                                    <td class="fw-bold">@item.TenSP<br><small class="text-muted">Lô: @item.MaLo</small></td>
                                    <td>Còn <b>@item.SoNgayConLai</b> ngày<br><small>@item.HanSuDung.ToString("dd/MM/yyyy")</small></td>
                                    <td>@item.SoLuongTon @item.DonViTinh</td>
                                    <td>
                                        <del class="text-muted">@item.GiaBanGoc.ToString("N0")đ</del><br>
                                        <span class="text-danger fw-bold fs-5">@item.GiaThucTe.ToString("N0")đ</span><br>
                                        <span class="badge bg-danger">Sale @item.PhanTramSale%</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card border-success mb-4">
                <div class="card-header bg-success text-white fw-bold">
                    ✅ HÀNG AN TOÀN
                </div>
                <div class="card-body">
                    <table class="table table-bordered text-center align-middle">
                        <thead>
                            <tr>
                                <th>Sản Phẩm</th>
                                <th>Hạn SD</th>
                                <th>Tồn Kho</th>
                                <th>Giá Bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in hangAnToan)
                            {
                                <tr>
                                    <td class="fw-bold">@item.TenSP<br><small class="text-muted">Lô: @item.MaLo</small></td>
                                    <td>Còn <b>@item.SoNgayConLai</b> ngày</td>
                                    <td>@item.SoLuongTon @item.DonViTinh</td>
                                    <td class="text-success fw-bold">@item.GiaThucTe.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white fw-bold">🛒 XUẤT KHO (BÁN HÀNG FIFO)</div>
                <div class="card-body">
                    <form asp-action="XuatKhoFIFO" method="post">
                        <div class="mb-3">
                            <label class="form-label">Chọn Sản Phẩm</label>
                            <select name="maSP" class="form-select" required>
                                <option value="SP01">Cà chua Hữu cơ</option>
                                <option value="SP02">Rau muống</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số Lượng Bán</label>
                            <input type="number" name="soLuongCanXuat" class="form-control" step="0.1" min="0.1" required placeholder="VD: 2.5">
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Thanh Toán & Xuất Kho</button>
                    </form>
                </div>
            </div>
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white fw-bold"><i class="fas fa-barcode"></i> QUÉT MÃ BÁN HÀNG (FIFO)</div>
                <div class="card-body">
                    <form asp-action="XuatKhoFIFO" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã Sản Phẩm (Quét mã)</label>
                            <div class="input-group">
                                <input type="text" id="inputMaSP" name="maSP" class="form-control border-primary" placeholder="Quét mã hoặc gõ (VD: SP01)" required autofocus autocomplete="off">
                                <button type="button" class="btn btn-outline-primary" id="btnTimSP"><i class="fas fa-search"></i></button>
                            </div>
                            <small id="spInfo" class="text-success fw-bold mt-2 d-block"></small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số Lượng Bán</label>
                            <div class="input-group">
                                <input type="number" id="inputSoLuong" name="soLuongCanXuat" class="form-control" required placeholder="0">
                                <span class="input-group-text bg-light fw-bold" id="spDonVi">...</span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold fs-5"><i class="fas fa-shopping-cart"></i> THANH TOÁN & XUẤT KHO</button>
                    </form>
                </div>
            </div>

            <div class="card border-secondary">
                <div class="card-header bg-secondary text-white fw-bold">📦 NHẬP LÔ HÀNG MỚI</div>
                <div class="card-body">
                    <form asp-action="NhapKho" method="post">
                        <div class="mb-2">
                            <input type="text" name="MaLo" class="form-control" placeholder="Mã Lô (VD: LO_004)" required>
                        </div>
                        <div class="mb-2">
                            <select name="MaSP" class="form-select" required>
                                <option value="SP01">Cà chua Hữu cơ</option>
                                <option value="SP02">Rau muống</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Ngày SX</label>
                            <input type="date" name="NgaySanXuat" class="form-control" required>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Hạn Sử Dụng</label>
                            <input type="date" name="HanSuDung" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <input type="number" name="SoLuongBanDau" class="form-control" step="0.1" min="1" placeholder="Số lượng nhập" required>
                        </div>
                        <button type="submit" class="btn btn-secondary w-100 fw-bold">Lưu Phiếu Nhập</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
    // Sự kiện: Khi máy quét mã vạch quét xong (hoặc gõ tay rồi ấn Enter/Click ra ngoài)
    $("#inputMaSP").on('change', function() {
    let maSP = $(this).val().trim();
    if(maSP.length > 0) {
    $.ajax({
    url: '/Home/GetProductInfo',
    type: 'GET',
    data: { maSP: maSP },
    success: function(res) {
    if(res.success) {
    // Cập nhật tên SP và Tồn kho
    $("#spInfo").html(`✅ <b>${res.tenSP}</b> | Tồn an toàn: ${res.tongTon} ${res.donViTinh}`).removeClass('text-danger').addClass('text-success');
    // Cập nhật hiển thị đơn vị
    $("#spDonVi").text(res.donViTinh);
                            
    // ĐIỀU CHỈNH NHẬP LƯỢNG THEO ĐƠN VỊ TÍNH
    if(res.donViTinh.toLowerCase() === 'bó' || res.donViTinh.toLowerCase() === 'hộp') {
    $("#inputSoLuong").attr('step', '1'); // Chỉ cho nhập số nguyên (1, 2, 3 bó)
    $("#inputSoLuong").attr('placeholder', 'Nhập số nguyên (1, 2, 3...)');
    } else {
    $("#inputSoLuong").attr('step', '0.1'); // Cho phép nhập số thập phân (1.5 Kg)
    $("#inputSoLuong").attr('placeholder', 'Nhập số thập phân (1.5, 2.0...)');
    }
                            
    // Tự động nhảy con trỏ chuột xuống ô nhập số lượng
    $("#inputSoLuong").focus();
    } else {
    $("#spInfo").html(`❌ ${res.message}`).removeClass('text-success').addClass('text-danger');
    $("#spDonVi").text("...");
    }
    }
    });
    }
    });
        
    // Hỗ trợ nút ấn tìm kiếm thủ công
    $("#btnTimSP").click(function(){
    $("#inputMaSP").trigger('change');
    });
    });
</script>
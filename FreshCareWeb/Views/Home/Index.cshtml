@{
    ViewData["Title"] = "Dashboard FreshCare";
}
<div class="container mt-4">
    <h2 class="text-center text-success mb-4 fw-bold">HỆ THỐNG QUẢN LÝ KHO FRESHCARE</h2>

    @if (TempData["Message"] != null)
    {
        string alertType = TempData["MessageType"]?.ToString() ?? "info";
        <div class="alert alert-@alertType fw-bold fs-4 text-center shadow border-2">
            @TempData["Message"]
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-12 p-4 bg-white border border-success rounded shadow-sm">
            <h4 class="text-success mb-3"><i class="bi bi-box-arrow-in-down"></i> Nghiệp Vụ Nhập Kho (Tạo Lô Hàng Mới)</h4>
            <form asp-controller="Home" asp-action="NhapKho" method="post" class="row g-3">
                <div class="col-md-2">
                    <label class="fw-bold">Mã Lô Mới</label>
                    <input type="text" name="MaLo" class="form-control" required placeholder="VD: LO_004" />
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Chọn Mặt Hàng</label>
                    <select name="MaSP" class="form-select" required>
                        <option value="SP01">Cà chua (SP01)</option>
                        <option value="SP02">Rau muống (SP02)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Ngày Sản Xuất</label>
                    <input type="date" name="NgaySanXuat" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="fw-bold">Hạn Sử Dụng</label>
                    <input type="date" name="HanSuDung" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="fw-bold">Số lượng (Kg)</label>
                    <input type="number" step="any" name="SoLuongBanDau" class="form-control" required min="0.1" />
                </div>
                <div class="col-12 mt-3">
                    <button type="submit" class="btn btn-success btn-lg">Lưu Phiếu Nhập Kho</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12 p-4 bg-light border border-primary rounded shadow-sm">
            <h4 class="text-primary mb-3"><i class="bi bi-box-seam"></i> Nghiệp Vụ Xuất Kho Tự Động (FIFO)</h4>
            <form asp-controller="Home" asp-action="XuatKhoFIFO" method="post" class="d-flex align-items-center">
                <label class="me-2 fw-bold fs-5">Mặt hàng cần xuất:</label>
                <select name="maSP" class="form-select w-25 me-4 fs-5" required>
                    <option value="SP01">Cà chua (SP01)</option>
                    <option value="SP02">Rau muống (SP02)</option>
                </select>
    
                <label class="me-2 fw-bold fs-5">Khối lượng (Kg):</label>
                <input type="number" step="any" name="soLuongCanXuat" class="form-control w-25 me-4 fs-5" required min="0.1" value="15" />
                <button type="submit" class="btn btn-primary btn-lg">Xuất Kho Ngay</button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-danger mb-3 shadow">
                <div class="card-header bg-danger text-white fw-bold fs-5">🚨 HÀNG QUÁ HẠN (YÊU CẦU XUẤT HỦY)</div>
                <div class="card-body p-0">
                    <table class="table table-hover text-center mb-0">
                        <thead class="table-danger"><tr><th>Mã Lô</th><th>Sản phẩm</th><th>Hạn Sử Dụng</th><th>Tồn kho</th></tr></thead>
                        <tbody>
                            @foreach (var item in ViewBag.HangQuaHan)
                            {
                                <tr><td class="fw-bold">@item.MaLo</td><td>@item.MaSP</td><td class="text-danger fw-bold">@item.HanSuDung.ToString("dd/MM/yyyy")</td><td class="fw-bold">@item.SoLuongTon Kg</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-warning mb-3 shadow">
                <div class="card-header bg-warning text-dark fw-bold fs-5">⚠️ HÀNG CẬN DATE (SẮP HẾT HẠN)</div>
                <div class="card-body p-0">
                    <table class="table table-hover text-center mb-0">
                        <thead class="table-warning"><tr><th>Mã Lô</th><th>Sản phẩm</th><th>Hạn Sử Dụng</th><th>Tồn kho</th></tr></thead>
                        <tbody>
                            @foreach (var item in ViewBag.HangCanDate)
                            {
                                <tr><td class="fw-bold">@item.MaLo</td><td>@item.MaSP</td><td class="text-warning fw-bold">@item.HanSuDung.ToString("dd/MM/yyyy")</td><td class="fw-bold">@item.SoLuongTon Kg</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card border-success shadow mb-5">
                <div class="card-header bg-success text-white fw-bold fs-5">✅ KHO HÀNG AN TOÀN (CÒN HẠN DÀI)</div>
                <div class="card-body p-0">
                    <table class="table table-hover text-center mb-0">
                        <thead class="table-success"><tr><th>Mã Lô</th><th>Sản phẩm</th><th>Hạn Sử Dụng</th><th>Tồn kho</th></tr></thead>
                        <tbody>
                            @foreach (var item in ViewBag.HangAnToan)
                            {
                                <tr>
                                    <td class="fw-bold">@item.MaLo</td>
                                    <td>@item.MaSP</td>
                                    <td class="text-success fw-bold">@item.HanSuDung.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold">@item.SoLuongTon Kg</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
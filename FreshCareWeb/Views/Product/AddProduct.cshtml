@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <a href="/Home/Index" class="text-primary text-decoration-none mb-3 d-inline-block">
                <i class="fas fa-long-arrow-alt-left"></i> Quay lại Bảng điều khiển
            </a>
            
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h4 class="text-success fw-bold"><i class="fas fa-box-open"></i> THÊM THÔNG TIN SẢN PHẨM</h4>
                    <p class="text-muted small">Thêm mặt hàng mới vào danh mục trước khi nhập lô hàng</p>
                </div>
                
                <div class="card-body p-4">
                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-@TempData["MessageType"]">
                            @TempData["Message"]
                        </div>
                    }

                    <form asp-controller="Product" asp-action="AddProduct" method="post">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Mã Sản Phẩm</label>
                                <input type="text" name="maSP" class="form-control" placeholder="VD: SP03" required autofocus />
                            </div>
                            
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Thuộc Danh Mục</label>
                                <select name="maDM" class="form-select" required>
                                    <option value="" disabled selected>-- Chọn danh mục sản phẩm --</option>
                                    @foreach (var dm in ViewBag.DanhMucList)
                                    {
                                        <option value="@dm.MaDM">@dm.TenDM</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Sản Phẩm</label>
                            <input type="text" name="tenSP" class="form-control" placeholder="VD: Cải bắp chuẩn VietGAP" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Đơn Vị Tính</label>
                                <select name="donViTinh" class="form-select" required>
                                    <option value="Kg">Ki-lô-gam (Kg)</option>
                                    <option value="Bó">Bó</option>
                                    <option value="Hộp">Hộp</option>
                                    <option value="Khay">Khay</option>
                                    <option value="Quả">Quả / Trái</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">Giá Bán Gốc (VNĐ)</label>
                                <input type="number" name="giaBan" class="form-control" min="1000" step="1000" placeholder="VD: 15000" required />
                            </div>
                        </div>

                        <hr />
                        <button type="submit" class="btn btn-success fw-bold px-4 py-2"><i class="fas fa-save"></i> LƯU SẢN PHẨM</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>